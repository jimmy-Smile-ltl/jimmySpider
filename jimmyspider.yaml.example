# jimmySpider 全局配置文件
#
# 使用方法：
#   1. 复制此文件为 jimmyspider.yaml
#   2. 修改下面的配置项
#   3. 放在项目根目录，或 ~/.jimmyspider.yaml（用户级配置）
#
# 配置优先级：环境变量 > YAML 配置文件 > 默认值
# 环境变量会覆盖 YAML 中的同名配置

# ============================================================
# MongoDB 数据库配置
# ============================================================
mongo_uri: "mongodb://localhost:27017/"   # MongoDB 连接地址
mongo_db: "jimmyspider"                   # 数据库名（所有爬虫共用）

# ============================================================
# Redis 缓存配置（断点续爬、去重、进度记录）
# ============================================================
redis_host: "127.0.0.1"     # Redis 地址
redis_port: 6379             # Redis 端口
redis_password: ""           # Redis 密码（无密码留空或删除此行）
redis_db: 0                  # Redis 数据库编号（0-15）

# ============================================================
# 文件存储配置
# ============================================================
data_dir: "~/spider_files"  # 下载文件根目录，支持 ~ 展开

# ============================================================
# 代理配置（三种方式选其一即可）
# ============================================================

# --- 方式一：隧道代理（最简单）---
# 直接设置代理隧道 URL，格式: http://用户名:密码@代理地址:端口
proxy_tunnel_url: ""
# 示例: proxy_tunnel_url: "http://user:pass@proxy.example.com:15818"

# --- 方式二：快代理 API 动态获取（可选）---
# 完整的快代理 API URL，用于动态获取代理 IP
proxy_api_url: ""
# 示例: proxy_api_url: "https://tps.kdlapi.com/api/gettps/?secret_id=xxx&signature=xxx&num=1&format=json&sep=1"

# ============================================================
# Clash 代理池配置（多节点自动切换，需要本地运行 Clash）
# ============================================================
clash_api_url: "http://127.0.0.1:9097"     # Clash External Controller 地址
clash_secret: ""                             # Clash API 密钥（在 Clash 配置中查看）
clash_proxy_url: "http://127.0.0.1:7897"    # Clash 代理端口
clash_policy_group: "自动选择"               # 使用的代理策略组名
# 常见策略组名: "自动选择", "🚀 节点选择", "Proxy", "GLOBAL"

# ============================================================
# 日志配置
# ============================================================
log_dir: ""                # 日志目录（留空则使用项目下的 logs/）

# ============================================================
# SSL/TLS 配置
# ============================================================
ssl_cert_file: ""          # 自定义 CA 证书路径（留空则用系统证书）
