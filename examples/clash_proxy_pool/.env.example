# Clash 代理池环境变量
# 复制为 .env 后使用

# Clash API 认证密钥（与 config/config.yaml 的 secret 一致）
CLASH_SECRET=your-secret-here

# Clash API 地址（docker-compose 映射的主机端口）
CLASH_API_URL=http://127.0.0.1:9099

# 切换节点后验证连通性的测试 URL
CLASH_TEST_URL=https://www.google.com/

# 策略组名称（与 config.yaml 中 proxy-groups 一致）
CLASH_GROUP_NAME=🚀节点选择

# 代理端口（docker-compose 映射的主机端口）
CLASH_PROXY_PORT=7777
